<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8+).

  The layers are generated by tools/make_brand_assets.py from the same master
  artwork the website uses: the ink background is a flat colour, the MB monogram
  (with its neon arc and equaliser bars) is the foreground, drawn small enough to
  survive every launcher mask, and the monochrome layer lets Android 13+ themed
  icons recolour the mark to match the user's wallpaper.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
