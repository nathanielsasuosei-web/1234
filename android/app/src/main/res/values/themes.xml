<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Two themes, both deliberately plain.

      Theme.Meetbeatz.Launcher — transparent, because android-browser-helper draws the
      splash screen itself (the MB monogram on the ink background declared in the
      manifest) and then hands the window over to Chrome. Giving the launcher activity
      its own background would flash twice.

      Theme.Meetbeatz.Fallback — used by the WebView shell when no browser on the device
      can host a Trusted Web Activity. It paints the ink background edge to edge so the
      status and navigation bars read as part of the page.
    -->
    <style name="Theme.Meetbeatz.Launcher" parent="@android:style/Theme.Translucent.NoTitleBar" />

    <style name="Theme.Meetbeatz.Fallback" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Meetbeatz.Fallback.Title">
        <item name="android:textColor">@color/cream</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Meetbeatz.Fallback.Body">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Meetbeatz.Fallback.Button">
        <item name="android:textColor">@color/ink</item>
        <item name="android:background">@color/acid</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>
</resources>
