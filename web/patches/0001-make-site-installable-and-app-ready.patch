diff --git a/public/sw.js b/public/sw.js
new file mode 100644
index 0000000..1827519
--- /dev/null
+++ b/public/sw.js
@@ -0,0 +1,204 @@
+/*
+ * Meetbeatz service worker.
+ *
+ * This file is deliberately small, dependency-free and conservative: it ships to a
+ * live storefront, so the rules are written around what must never happen rather
+ * than around maximum cache hits.
+ *
+ *   - Never cached, never served from cache: /api/*, /admin*, /checkout*,
+ *     /orders/*, /license/*, /account*, /cart. These carry a customer's session,
+ *     their cart, their order, or their licence key. A cached copy of one of those
+ *     could be shown to the next person who opens the app on a shared phone.
+ *   - Navigations are network-first: online, the customer always gets fresh
+ *     prices and stock; offline, they get the last copy of that page they saw, and
+ *     failing that the branded offline page below.
+ *   - Build output and icons are cache-first, because a file under
+ *     /_next/static/ has a content hash in its name — it can never be stale.
+ *   - POST/PUT/PATCH/DELETE are never touched at all: checkout is a POST.
+ *
+ * It also carries the two push handlers, so a notification sent by the site opens
+ * the page it is about and focuses the app instead of starting a second copy.
+ */
+
+const VERSION = "v1";
+const SHELL_CACHE = `meetbeatz-shell-${VERSION}`;
+const ASSET_CACHE = `meetbeatz-assets-${VERSION}`;
+const PAGE_CACHE = `meetbeatz-pages-${VERSION}`;
+const KNOWN_CACHES = [SHELL_CACHE, ASSET_CACHE, PAGE_CACHE];
+
+const OFFLINE_URL = "/offline.html";
+const SHELL_ASSETS = [
+  OFFLINE_URL,
+  "/manifest.webmanifest",
+  "/icons/icon-192.png",
+  "/icons/icon-512.png",
+];
+
+/** Paths that must always come from the network. */
+const NEVER_CACHE = [
+  /^\/api\//,
+  /^\/admin/,
+  /^\/checkout/,
+  /^\/orders\//,
+  /^\/license\//,
+  /^\/account/,
+  /^\/cart/,
+];
+
+const isPrivate = (pathname) => NEVER_CACHE.some((pattern) => pattern.test(pathname));
+
+/** Files whose name contains a build hash, so the bytes can never change. */
+const isImmutable = (pathname) =>
+  pathname.startsWith("/_next/static/") ||
+  pathname.startsWith("/icons/") ||
+  pathname.startsWith("/images/") ||
+  pathname.startsWith("/audio/");
+
+self.addEventListener("install", (event) => {
+  event.waitUntil(
+    (async () => {
+      const cache = await caches.open(SHELL_CACHE);
+      // Individual failures must not fail the whole install: a missing icon would
+      // otherwise leave the site with no service worker at all.
+      await Promise.all(
+        SHELL_ASSETS.map((asset) => cache.add(asset).catch(() => undefined)),
+      );
+      await self.skipWaiting();
+    })(),
+  );
+});
+
+self.addEventListener("activate", (event) => {
+  event.waitUntil(
+    (async () => {
+      const names = await caches.keys();
+      await Promise.all(
+        names
+          .filter((name) => name.startsWith("meetbeatz-") && !KNOWN_CACHES.includes(name))
+          .map((name) => caches.delete(name)),
+      );
+      if (self.registration.navigationPreload) {
+        // Serve the network's response while the page is still being parsed.
+        await self.registration.navigationPreload.disable();
+      }
+      await self.clients.claim();
+    })(),
+  );
+});
+
+self.addEventListener("fetch", (event) => {
+  const { request } = event;
+
+  if (request.method !== "GET") return;
+
+  const url = new URL(request.url);
+
+  // Third-party requests (Paystack's checkout frame, Google's tag manager, the
+  // WhatsApp link) are none of this worker's business.
+  if (url.origin !== self.location.origin) return;
+
+  if (isPrivate(url.pathname)) return;
+
+  if (request.mode === "navigate") {
+    event.respondWith(handleNavigation(request));
+    return;
+  }
+
+  if (isImmutable(url.pathname)) {
+    event.respondWith(cacheFirst(request, ASSET_CACHE));
+  }
+});
+
+/**
+ * Network-first navigation with three fallbacks: the cached copy of the exact page,
+ * the cached copy of the same section (so an offline tap on a beat still lands on
+ * the store), and finally the offline page.
+ */
+async function handleNavigation(request) {
+  try {
+    const response = await fetch(request);
+    if (response && response.ok && response.type === "basic") {
+      const copy = response.clone();
+      caches
+        .open(PAGE_CACHE)
+        .then((cache) => cache.put(request, copy))
+        .catch(() => undefined);
+    }
+    return response;
+  } catch (_) {
+    const cached = await caches.match(request, { ignoreSearch: true });
+    if (cached) return cached;
+
+    const shell = await caches.open(SHELL_CACHE);
+    const offline = await shell.match(OFFLINE_URL);
+    if (offline) return offline;
+
+    return new Response("You are offline.", {
+      status: 503,
+      headers: { "Content-Type": "text/plain; charset=utf-8" },
+    });
+  }
+}
+
+async function cacheFirst(request, cacheName) {
+  const cached = await caches.match(request);
+  if (cached) return cached;
+
+  const response = await fetch(request);
+  if (response && response.ok && response.type === "basic") {
+    const copy = response.clone();
+    caches
+      .open(cacheName)
+      .then((cache) => cache.put(request, copy))
+      .catch(() => undefined);
+  }
+  return response;
+}
+
+/* ------------------------------------------------------------------ push ------ */
+
+self.addEventListener("push", (event) => {
+  let payload = {};
+  try {
+    payload = event.data ? event.data.json() : {};
+  } catch (_) {
+    payload = { body: event.data ? event.data.text() : "" };
+  }
+
+  const title = payload.title || "Meetbeatz";
+  const options = {
+    body: payload.body || "",
+    icon: payload.icon || "/icons/icon-192.png",
+    badge: "/icons/icon-192.png",
+    // Anything the producer sends is about one order, one licence or one slot, so
+    // replacing a notification of the same kind beats stacking duplicates.
+    tag: payload.tag || "meetbeatz",
+    renotify: true,
+    data: { url: payload.url || "/account" },
+  };
+
+  event.waitUntil(self.registration.showNotification(title, options));
+});
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close();
+  const target = new URL(event.notification.data?.url || "/", self.location.origin).href;
+
+  event.waitUntil(
+    (async () => {
+      const clients = await self.clients.matchAll({
+        type: "window",
+        includeUncontrolled: true,
+      });
+
+      for (const client of clients) {
+        if (client.url.startsWith(self.location.origin) && "focus" in client) {
+          await client.navigate(target).catch(() => undefined);
+          return client.focus();
+        }
+      }
+
+      return self.clients.openWindow(target);
+    })(),
+  );
+});
diff --git a/src/app/api/push/subscribe/route.ts b/src/app/api/push/subscribe/route.ts
new file mode 100644
index 0000000..a14ca06
--- /dev/null
+++ b/src/app/api/push/subscribe/route.ts
@@ -0,0 +1,90 @@
+import { db } from "@/db";
+import { admins, customers } from "@/db/schema";
+import { getAdminSession } from "@/lib/auth";
+import { getCustomerSession } from "@/lib/customer-auth";
+import { eq } from "drizzle-orm";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * Stores a Web Push subscription for the Meetbeatz Android app.
+ *
+ * A Trusted Web Activity is the site itself, so its notifications are the site's
+ * notifications: Chrome delivers them through the app's `DelegationService`, and
+ * tapping one reopens the app instead of a browser tab. What is missing without
+ * this endpoint is a place to keep the subscription — the service worker has the
+ * push handler (public/sw.js) but nothing records where to send.
+ *
+ * Deliberately small and additive: no new dependency, and no delivery code.
+ *
+ *   - The subscription is stored on `admins` for the producer's own devices and on
+ *     `customers` for buyers. Both columns (`push_subscription`) ship in the same
+ *     patch as this file and are nullable, so the schema push the build already runs
+ *     adds them on the next deploy and nothing else has to change.
+ *   - Sending is left to whatever the producer already uses: `notifyProducer()` in
+ *     src/lib/notifications.ts is the single place every booking, order and message
+ *     already flows through, so it is the natural place to read these rows and POST
+ *     to each subscription's endpoint with VAPID keys.
+ *
+ * Until a sender exists this endpoint is harmless: with no caller it stores nothing,
+ * and the site works exactly as before.
+ */
+
+type SubscriptionBody = {
+  endpoint?: unknown;
+  keys?: { p256dh?: unknown; auth?: unknown };
+  topic?: unknown;
+};
+
+function parseSubscription(payload: SubscriptionBody) {
+  const endpoint = String(payload.endpoint ?? "").trim();
+  const p256dh = String(payload.keys?.p256dh ?? "").trim();
+  const auth = String(payload.keys?.auth ?? "").trim();
+
+  if (!endpoint.startsWith("https://") || !p256dh || !auth) return null;
+  // Nothing else about a subscription is trusted: the endpoint is an opaque HTTPS
+  // URL supplied by the browser, and only the push service can act on it.
+  return { endpoint, p256dh, auth, topic: String(payload.topic ?? "").slice(0, 120) };
+}
+
+export async function POST(req: Request) {
+  const subscription = parseSubscription((await req.json().catch(() => ({}))) as SubscriptionBody);
+  if (!subscription) {
+    return Response.json({ error: "That is not a valid push subscription." }, { status: 400 });
+  }
+
+  const stored = JSON.stringify({
+    endpoint: subscription.endpoint,
+    keys: { p256dh: subscription.p256dh, auth: subscription.auth },
+    savedAt: new Date().toISOString(),
+    topic: subscription.topic || undefined,
+  });
+
+  // Producer first: a signed-in admin device is what a booking alert should reach.
+  try {
+    const admin = await getAdminSession();
+    if (admin) {
+      await db.update(admins).set({ pushSubscription: stored }).where(eq(admins.id, admin.id));
+      return Response.json({ ok: true, audience: "admin" });
+    }
+  } catch (err) {
+    console.warn("[api/push/subscribe] admin save skipped", err);
+  }
+
+  try {
+    const customer = await getCustomerSession();
+    if (customer) {
+      await db
+        .update(customers)
+        .set({ pushSubscription: stored })
+        .where(eq(customers.id, customer.id));
+      return Response.json({ ok: true, audience: "customer" });
+    }
+  } catch (err) {
+    console.warn("[api/push/subscribe] customer save skipped", err);
+  }
+
+  // Anonymous visitors get a 200 with `stored: false`: the permission prompt is a
+  // deliberate choice by the customer and should not look like a failure here.
+  return Response.json({ ok: true, stored: false, audience: "anonymous" });
+}
